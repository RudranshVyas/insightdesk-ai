# Copy to .env and fill in. Never commit .env.

# --- Paths (defaults are repo-relative; override only if needed) ---
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts
# DATABASE_URL=sqlite:///./artifacts/insightdesk.db

# --- LLM (entirely optional; app must fully work with LLM_PROVIDER=none) ---
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_REVISION=   # leave blank unless you verified the hash locally

# --- API ---
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=65536
MAX_ISSUE_TEXT_CHARS=8000
