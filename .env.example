# Everything works with no key at all. This file only unlocks the AI summary.
#
# LLM_PROVIDER=none is the default and a fully supported operating state, not a
# degraded one: retrieval, the strength gate, evidence curation, the verifier and
# the whole UI run without a provider.

LLM_PROVIDER=none

# --- Optional: turn on the AI summary ---------------------------------------
# All of the providers below run permanent free tiers and speak the OpenAI
# chat-completions shape, so one implementation covers them. Pick one, set the
# key, set a model. Base URLs are built in; LLM_BASE_URL overrides them.
#
# Rate limits are deliberately NOT recorded here. They change, and a number
# baked into a config file becomes a lie on a schedule — check the provider.
#
#   Groq       LLM_PROVIDER=groq       LLM_MODEL=llama-3.3-70b-versatile
#   Gemini     LLM_PROVIDER=gemini     LLM_MODEL=gemini-2.5-flash
#   Cerebras   LLM_PROVIDER=cerebras   LLM_MODEL=llama-3.3-70b
#   OpenRouter LLM_PROVIDER=openrouter LLM_MODEL=<any free model id>
#   Mistral    LLM_PROVIDER=mistral    LLM_MODEL=mistral-small-latest
#   Anthropic  LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5   (paid)
#
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=            # only to point somewhere non-standard

LLM_TIMEOUT_SECONDS=60

# --- Embeddings --------------------------------------------------------------
# Changing this invalidates the index, the gate thresholds, and any recorded
# evaluation baseline. Rebuild and re-record if you change it.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observability -----------------------------------------------------------
OTEL_ENABLED=false

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
